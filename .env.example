SECRET_KEY=change-me-before-production
ENCRYPTION_KEY=change-me-before-production
ADMIN_USER=admin
ADMIN_PASSWORD=your-admin-password
DATABASE_URL=sqlite:///./data/app.db

# Listener ports. HTTP_PORT is used when SSL is disabled (default), TLS_PORT
# is used when SSL is enabled in Settings -> SSL Certificate Management.
HTTP_PORT=8000
TLS_PORT=8443

# Where server.key / server.crt live. /app/data/ssl in Docker, ./data/ssl
# for local development.
SSL_CERT_DIR=./data/ssl

# Optional override of the DB-stored ssl_enabled toggle. Set to 0 in CI or
# during local development to force HTTP without restarting the container.
# Leave unset in production and manage SSL from the admin UI instead.
# SSL_ENABLED=0
