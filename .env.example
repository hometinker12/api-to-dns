# Required. The app refuses to start with missing or placeholder values unless
# API_TO_DNS_ALLOW_INSECURE_DEFAULTS=1 (tests/dev only).
SECRET_KEY=change-me-before-production
ENCRYPTION_KEY=change-me-before-production
ADMIN_USER=admin
ADMIN_PASSWORD=your-admin-password
DATABASE_URL=sqlite:///./data/app.db

# Listener ports. HTTP_PORT is used when SSL is disabled (default), TLS_PORT
# is used when SSL is enabled in Settings -> SSL Certificate Management.
HTTP_PORT=8000
TLS_PORT=8443

# Where server.key / server.crt live. /app/data/ssl in Docker, ./data/ssl
# for local development.
APP_SSL_DIR=./data/ssl

# Optional override of the DB-stored ssl_enabled toggle.
# Leave unset so Settings -> SSL Certificate Management controls HTTPS.
# If set to 0, bootstrap always starts HTTP even when SSL is enabled in the UI.
# Set to 0 only for CI or local forced-HTTP; set to 1 only to force HTTPS.
# SSL_ENABLED=0

# Let's Encrypt defaults. The admin UI stores the active configuration in the
# database; LETSENCRYPT_RENEW_DAYS is only used as a fallback when unset there.
LETSENCRYPT_RENEW_DAYS=30
# LETSENCRYPT_STAGING=0

# Optional local timezone for scheduled certificate restart windows.
# TZ=America/New_York

# CORS_ORIGINS=https://admin.example.com,https://app.example.com
# Comma-separated browser origins allowed for CORS. Empty (default) disables
# cross-origin browser access. Never auto-enabled from insecure crypto defaults.
# CORS_ORIGINS=

# Session cookie Secure attribute.
# SESSION_COOKIE_SECURE=1 forces Secure cookies (recommended behind TLS termination).
# SESSION_COOKIE_SECURE=0 forces non-Secure cookies.
# When unset, Secure follows HTTPS request scheme, trusted X-Forwarded-Proto
# (only if TRUST_PROXY_HEADERS=1), then the in-app SSL toggle.
# SESSION_COOKIE_SECURE=1
# TRUST_PROXY_HEADERS=0

# Expose /openapi.json, /docs, and /redoc. Default is off in production.
# OPENAPI_ENABLED=0

# Include exception tracebacks in HTML error pages (dev only).
# DEBUG_ERRORS=0

# Rate limits as max_requests:window_seconds (optional overrides).
# RATE_LIMIT_LOGIN=20:60
# RATE_LIMIT_KEYCHECK=60:60
# RATE_LIMIT_DNS_RECORD=180:60
# RATE_LIMIT_DNS_BROWSER=60:60
# API_TO_DNS_DISABLE_RATE_LIMIT=1
